generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id           String   @id @default(cuid())
  name         String
  samsaraOrgId String?
  createdAt    DateTime @default(now())
  drivers      Driver[]
}

model Driver {
  id                 String                  @id @default(cuid())
  telegramUserId     String                  @unique
  /// Telegram first name at last /api/driver call. Legacy field name; this is
  /// authentication-identity, not the operational identity — see canonicalName.
  name               String
  telegramLastName   String?
  telegramUsername   String?
  samsaraDriverId    String?
  /// Operational identity for reports/dashboards/analytics. Nullable until a
  /// provider mapping with a known name exists. Auto-synced from the active
  /// provider mapping's providerDriverName (see lib/driverIdentity.ts) —
  /// no manual override exists yet.
  canonicalName      String?
  companyId          String
  company            Company                 @relation(fields: [companyId], references: [id])
  createdAt          DateTime                @default(now())
  trips              Trip[]
  safetyEvents       SafetyEvent[]
  complianceScores   ComplianceScore[]
  incidents          Incident[]
  inspections        Inspection[]
  providerMappings   DriverProviderMapping[]
  driverEvents       DriverEvent[]
  legalAcceptances   LegalAcceptance[]
  driverObservations DriverObservation[]
}

model Trip {
  id           String        @id @default(cuid())
  driverId     String
  driver       Driver        @relation(fields: [driverId], references: [id])
  startedAt    DateTime
  endedAt      DateTime?
  milesDriven  Float         @default(0)
  weatherData  Json?
  createdAt    DateTime      @default(now())
  safetyEvents SafetyEvent[]
  incidents    Incident[]
  inspections  Inspection[]
}

model SafetyEvent {
  id             String   @id @default(cuid())
  driverId       String
  driver         Driver   @relation(fields: [driverId], references: [id])
  tripId         String?
  trip           Trip?    @relation(fields: [tripId], references: [id])
  eventType      String
  severity       String
  lat            Float?
  lng            Float?
  timestamp      DateTime
  samsaraEventId String?
  createdAt      DateTime @default(now())
}

model ComplianceScore {
  id            String   @id @default(cuid())
  driverId      String
  driver        Driver   @relation(fields: [driverId], references: [id])
  date          DateTime
  score         Int
  breakdownJson Json?
  dangerLevel   String
  createdAt     DateTime @default(now())
}

model Incident {
  id            String   @id @default(cuid())
  driverId      String
  driver        Driver   @relation(fields: [driverId], references: [id])
  tripId        String?
  trip          Trip?    @relation(fields: [tripId], references: [id])
  description   String?
  transcript    String?
  photoUrls     String[]
  location      String?
  fmcsaReported Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Inspection {
  id            String   @id @default(cuid())
  driverId      String
  driver        Driver   @relation(fields: [driverId], references: [id])
  tripId        String?
  trip          Trip?    @relation(fields: [tripId], references: [id])
  photoUrl      String? // Supabase Storage path; null after photo expiry
  photosExpired Boolean  @default(false)
  overallResult String // "PASS" | "WARN" | "FAIL"
  summary       String
  confidence    Float
  checkItems    Json // CheckItem[]
  analysisJson  Json // raw AI response
  retainUntil   DateTime // photo expiry date (row is kept permanently)
  createdAt     DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Provider integration layer
// ---------------------------------------------------------------------------

/// One row per external provider organisation (e.g. a Samsara fleet account).
/// Holds org-level config and pilot flag so pilot cohorts can be filtered
/// at the account level as well as at the individual driver level.
model ProviderAccount {
  id            String                  @id @default(cuid())
  provider      String // "samsara" | "geotab" | future providers
  name          String // human-readable label, e.g. "Acme Samsara Fleet"
  externalOrgId String? // org / fleet ID in the provider system
  isPilot       Boolean                 @default(false)
  isActive      Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  mappings      DriverProviderMapping[]

  @@unique([provider, externalOrgId])
  @@index([provider])
  @@index([isPilot])
}

/// Maps one SafeHaul Driver to one external provider driver identity.
/// Exactly one mapping per driver per provider is enforced by the unique constraint.
/// `provider` is denormalized from ProviderAccount for direct filtering without a join.
model DriverProviderMapping {
  id                 String           @id @default(cuid())
  driverId           String
  driver             Driver           @relation(fields: [driverId], references: [id])
  providerAccountId  String?
  providerAccount    ProviderAccount? @relation(fields: [providerAccountId], references: [id])
  provider           String // "samsara" | "geotab" | etc. (denormalized)
  externalDriverId   String // driver ID in the external system
  /// Raw driver name as last reported by the provider (e.g. Samsara driver.name
  /// on an inbound event). Drives Driver.canonicalName — see lib/driverIdentity.ts.
  providerDriverName String?
  externalVehicleId  String? // vehicle / asset ID in the external system
  isPilot            Boolean          @default(false)
  isActive           Boolean          @default(true)
  syncedAt           DateTime? // timestamp of last successful data sync
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([provider, externalDriverId])
  @@unique([driverId, provider])
  @@index([driverId])
  @@index([isPilot])
  @@index([provider])
}

/// Raw receipt log for every verified inbound webhook (HTTP request layer).
/// One row per verified POST request, regardless of whether the event was processed.
model WebhookLog {
  id                String             @id @default(cuid())
  provider          String // "samsara" | future providers
  eventType         String? // event type extracted from payload, if available
  externalDriverId  String? // external driver ID extracted from payload, if available
  rawPayload        Json // full payload preserved for replay / debugging
  receivedAt        DateTime           @default(now())
  rawProviderEvents RawProviderEvent[]

  @@index([provider])
  @@index([receivedAt])
  @@index([externalDriverId])
}

/// Parsed provider event — one row per discrete event extracted from a webhook or stream poll.
/// Stores the raw payload for replay and links forward to normalized DriverEvent rows.
/// Created after successful payload parse, before normalization or driver resolution.
model RawProviderEvent {
  id              String        @id @default(cuid())
  webhookLogId    String?
  webhookLog      WebhookLog?   @relation(fields: [webhookLogId], references: [id])
  provider        String // "samsara" | future providers
  source          String        @default("webhook") // "webhook" | "stream"
  externalEventId String? // provider's deduplication ID
  rawPayload      Json // full raw event payload from provider
  receivedAt      DateTime      @default(now())
  driverEvents    DriverEvent[]

  // Unique on (provider, externalEventId) when externalEventId is non-null.
  // PostgreSQL allows multiple NULL values under a partial unique constraint,
  // so events without a provider-side ID are stored freely (no false dedup).
  // This constraint also deduplicates events that arrive via both webhook AND stream.
  @@unique([provider, externalEventId])
  @@index([provider, source])
  @@index([receivedAt])
}

/// Persistent cursor state for provider stream polling.
/// One row per (provider, streamKey) pair — keyed generically so future providers
/// (Motive, Geotab, etc.) and additional stream types share the same table.
model ProviderSyncState {
  id              String    @id @default(cuid())
  provider        String // "samsara" | future providers
  streamKey       String // "safety-events" | future stream identifiers
  cursor          String? // last endCursor from pagination; null triggers cold-start bootstrap
  cursorStartTime DateTime? // the `startTime` window-start that `cursor` is relative to — kept in lockstep with `cursor` so a resumed drain always reuses the exact startTime the cursor was established under, never a freshly invented one. Null whenever `cursor` is null. A non-null `cursor` paired with a null `cursorStartTime` is legacy state from before this field existed (see lib/providers/samsara/syncSafetyEvents.ts for how that incomplete pair is handled safely).
  lastSyncAt      DateTime?
  syncLockedAt    DateTime? // set while an on-demand sync is claimed; stale locks are reclaimable (see lib/providers/samsara/onDemandSync.ts)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([provider, streamKey])
  @@index([provider])
}

/// TEMPORARY diagnostic table (added 2026-08-04, HOS observability investigation)
/// — answers "does Samsara's HOS Clocks endpoint ever return an entry for
/// this pilot driver?" without touching risk scoring or exposing raw
/// provider payloads anywhere. One throttled row per (driver, ~15min
/// window) — see lib/providers/samsara/hosObservability.ts. Not read by any
/// scoring/UI code path; safe to drop once the underlying provider-side
/// question is answered. Deliberately has no `driver` relation (unlike
/// DriverEvent) — kept fully decoupled from the core domain model so it can
/// be removed without touching Driver.
model HosObservation {
  id                String    @id @default(cuid())
  driverId          String // SafeHaul internal driver ID (not a DB relation — see model comment)
  externalDriverId  String // Samsara driver ID from DriverProviderMapping at request time
  requestedAt       DateTime  @default(now())
  clocksReturned    Boolean // true if Samsara's HOS Clocks `data` array was non-empty
  emptyReason       String? // e.g. "no_active_clock_entries" | "no_provider_mapping" | "fetch_error"
  providerStatus    Int? // Samsara's HTTP status code, when a request was actually made
  providerUpdatedAt DateTime? // Samsara's own lastUpdatedAtTime on the clock entry, when present

  @@index([driverId, requestedAt])
}

/// Provider-neutral normalized driver safety event.
/// Only created when a verified pilot driver mapping exists.
/// This is the stable internal representation — never tightly coupled to Samsara fields.
///
/// TODO: Wire into risk engine in Phase 4.
model DriverEvent {
  id                 String              @id @default(cuid())
  driverId           String
  driver             Driver              @relation(fields: [driverId], references: [id])
  rawProviderEventId String
  rawProviderEvent   RawProviderEvent    @relation(fields: [rawProviderEventId], references: [id])
  provider           String // source provider (denormalized for query convenience)
  externalDriverId   String // external ID at event time (audit trail)
  externalVehicleId  String? // external vehicle ID at event time
  type               String // internal event type — see DriverEventType in lib/
  severity           Float // normalized 1–5 scale
  timestamp          DateTime // event time as reported by provider
  lat                Float?
  lng                Float?
  createdAt          DateTime            @default(now())
  driverObservations DriverObservation[]

  @@index([driverId])
  @@index([driverId, timestamp])
  @@index([type])
  @@index([provider])
}

/// Point-in-time snapshot of a pilot driver's operational context (location,
/// speed, HOS, weather, zone risk) — Phase 6B, "what conditions existed."
/// Deliberately separate from DriverEvent ("what happened") and any future
/// RiskScoreHistory ("what SafeHaul calculated from those conditions") — see
/// the Phase 6B design writeup for why these stay three distinct concepts
/// rather than collapsing into one table.
///
/// Phase 6B.1 adds this table only. Nothing writes to it yet — no collector,
/// no scheduler, no Safety Event hook exist as of this migration. See
/// lib/driverContext/assemble.ts and lib/driverContext/types.ts for the
/// existing provenance model this table is designed to sit alongside, not
/// replace: DriverContextField/VehicleLocation/WeatherDetail/HosDetail/
/// ZoneDetail already carry origin/state/provider/observedAt/fetchedAt per
/// field — contextJson below is intended to store those existing typed
/// objects directly once a collector exists, never a reinvented parallel
/// vocabulary of new provenance columns.
model DriverObservation {
  id       String @id @default(cuid())
  driverId String
  driver   Driver @relation(fields: [driverId], references: [id])

  /// "interval" (periodic baseline while a pilot vehicle is active) |
  /// "safety_event" (best-effort capture triggered by a newly discovered
  /// Safety Event) — plain string, matching this schema's existing
  /// convention for status/type discriminators (see DriverEvent.type,
  /// ProviderSyncState's cursor semantics) rather than a Prisma enum.
  triggerType String

  /// Set only when triggerType = "safety_event" — records *why* this row
  /// was captured, not an exhaustive link registry. Deliberately NOT
  /// @unique on its own: nothing should prevent a DIFFERENT triggerType from
  /// referencing the same DriverEvent in some future design. The composite
  /// @@unique([driverEventId, triggerType]) below (Phase 6B.5) is the real
  /// guarantee this model makes: at most one "safety_event" observation per
  /// DriverEvent — enforced at the DB level as the source of truth (see
  /// lib/driverContext/eventEnrichment.ts's P2002 handling), with
  /// enrichment's own findFirst pre-check only as an optimization to avoid
  /// the provider round-trip on the common (non-racing) path. PostgreSQL
  /// treats every NULL as distinct under a unique constraint, so this never
  /// limits "interval" observations (driverEventId always null there) —
  /// verified against the live database before this constraint was added:
  /// three pre-existing "interval" rows, all with driverEventId = null,
  /// coexisted under this constraint with no conflict.
  /// No explicit onDelete is set here, matching this schema's existing
  /// convention for optional relations (see SafetyEvent.trip/Incident.trip/
  /// Inspection.trip, none of which declare one either): Prisma's implicit
  /// default for an OPTIONAL relation is onDelete: SetNull, which is exactly
  /// the desired behavior — deleting a DriverEvent must never cascade-delete
  /// the historical DriverObservation rows that reference it; the
  /// observation survives with driverEventId set to null instead.
  driverEventId String?
  driverEvent   DriverEvent? @relation(fields: [driverEventId], references: [id])

  /// The instant the conditions in this row are claimed to represent.
  /// Deliberately NOT the same field as DriverEvent.timestamp (eventAt) —
  /// for a safety_event-triggered row this is the discovery/collection
  /// instant, never backdated to when the event actually happened. There is
  /// intentionally no `eventAt` column on this model: for event-triggered
  /// rows, eventAt already lives on the linked DriverEvent.timestamp via
  /// driverEventId — duplicating it here would be a second source of truth.
  observedAt DateTime

  /// The wall-clock instant SafeHaul's collector actually ran the fetch.
  /// Kept as a separate column from observedAt even though the two will
  /// coincide for every row Phase 6B.2's synchronous collector produces —
  /// this is forward-compatibility for a future async/backfill-capable
  /// collector, not a distinction that matters yet.
  collectedAt DateTime @default(now())

  /// Query-friendly scalar projections for future analytics/ML feature
  /// extraction ONLY — never a second source of truth. Full provenance
  /// (origin/state/provider/observedAt/fetchedAt per field) belongs in
  /// contextJson, reusing the existing DriverContext-adjacent detail types
  /// verbatim rather than being re-derived as more columns here.
  latitude          Float?
  longitude         Float?
  speedMph          Float?
  hosShiftHoursUsed Float?
  weatherRisk       Float?
  zoneRisk          Float?

  /// Full context snapshot — intended to hold the existing VehicleLocation /
  /// WeatherDetail / HosDetail / ZoneDetail objects (lib/driverContext/types.ts)
  /// as captured by a future collector. Required (not nullable): a
  /// DriverObservation row only makes sense once a collector has actually
  /// captured context — Phase 6B.1 creates no rows at all, so this
  /// constraint has no existing data to violate.
  contextJson Json

  createdAt DateTime @default(now())

  @@unique([driverEventId, triggerType])
  @@index([driverId, observedAt])
  @@index([driverEventId])
}

// ---------------------------------------------------------------------------
// Legal onboarding layer (Phase 4.6B)
// ---------------------------------------------------------------------------

/// One row per published legal document version (Terms of Use, Privacy
/// Notice, future document types). A revision is always a NEW row — content
/// is immutable once published, never edited in place.
///
/// "Only one active version per type" is enforced in application code
/// (lib/legal.ts::activateLegalDocument), not a DB constraint — Prisma's
/// schema language has no partial-unique-index support without a raw
/// migration, and this project currently applies schema via `db push`
/// (see CLAUDE.md). Documented here as a known future-hardening item.
model LegalDocument {
  id          String            @id @default(cuid())
  type        String // "terms_of_use" | "privacy_notice" | future types — see lib/legal.ts LegalDocumentType
  version     Int // 1, 2, 3... monotonically increasing per type
  title       String
  content     String // placeholder copy for now — see prisma/seed.ts
  contentHash String // sha256 of `content`, for integrity/tamper-evidence
  publishedAt DateTime          @default(now())
  effectiveAt DateTime // when this version becomes the one drivers must accept
  isActive    Boolean           @default(false)
  createdAt   DateTime          @default(now())
  acceptances LegalAcceptance[]

  @@unique([type, version])
  @@index([type])
  @@index([type, isActive])
}

/// One row per (driver, document version) acceptance event. A driver accepts
/// each version at most once (unique constraint) but accumulates a new row
/// per version over time as revisions are published — this history is what
/// makes future versions "automatically" require re-acceptance with no code
/// changes: the status check just compares active document IDs against
/// accepted document IDs (see lib/legal.ts::getLegalStatus).
model LegalAcceptance {
  id              String        @id @default(cuid())
  driverId        String
  driver          Driver        @relation(fields: [driverId], references: [id])
  legalDocumentId String
  legalDocument   LegalDocument @relation(fields: [legalDocumentId], references: [id])
  /// Snapshot of the Telegram user ID at acceptance time — evidentiary, kept
  /// even if the Driver record's identity fields change later.
  telegramUserId  String
  acceptedAt      DateTime      @default(now())
  userAgent       String? // best-effort, from the request's User-Agent header
  ipAddress       String? // best-effort, from X-Forwarded-For; never client-supplied

  @@unique([driverId, legalDocumentId])
  @@index([driverId])
  @@index([legalDocumentId])
}
